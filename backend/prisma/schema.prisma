// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUARIOS Y ROLES (Fase 1 — auth)
// ============================================================

// Tabla central de autenticación.
// Cualquier persona que se loguea es un Usuario. El rol determina qué endpoints puede usar.
model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  rol          RolUsuario
  activo       Boolean    @default(true)

  nombre   String
  apellido String
  telefono String?

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  ultimoLoginAt DateTime? @map("ultimo_login_at")

  productor           Productor?
  proveedor           Proveedor?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  campanasCreadas     Campana[]            @relation("CampanasCreadas")
  notificaciones      Notificacion[]
  movimientosStockEjecutados StockMovimiento[]

  @@map("usuarios")
}

enum RolUsuario {
  PRODUCTOR
  PROVEEDOR
  ADMIN
  OPERADOR
  CONTADOR
  OPERADOR_DEPOSITO
}

// Extensión del Usuario cuando el rol es PRODUCTOR.
model Productor {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  razonSocial     String          @map("razon_social")
  cuit            String          @unique
  condicionFiscal CondicionFiscal @map("condicion_fiscal")
  domicilioFiscal String          @map("domicilio_fiscal")
  localidad       String

  // Para tracking de aprobación por AUT (regla D.3)
  aprobado   Boolean   @default(false)
  aprobadoAt DateTime? @map("aprobado_at")

  createdAt DateTime @default(now()) @map("created_at")

  intenciones IntencionCompra[]
  ordenes     OrdenCompra[]
  entregas    Entrega[]

  @@map("productores")
}

enum CondicionFiscal {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  CONSUMIDOR_FINAL
}

// Extensión del Usuario cuando el rol es PROVEEDOR. Régimen cerrado: AUT da de alta manualmente (regla C.4).
model Proveedor {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  razonSocial     String          @map("razon_social")
  cuit            String          @unique
  condicionFiscal CondicionFiscal @map("condicion_fiscal")
  domicilioFiscal String          @map("domicilio_fiscal")

  estadoAprobacion EstadoAprobacion @default(PENDIENTE) @map("estado_aprobacion")
  notasInternas    String?          @map("notas_internas") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  cotizaciones Cotizacion[]

  @@map("proveedores")
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
  SUSPENDIDO
}

// ============================================================
// CATÁLOGO DE PRODUCTOS (Fase 3)
// ============================================================

model Producto {
  id           Int               @id @default(autoincrement())
  nombre       String            @unique
  descripcion  String?           @db.Text
  categoria    CategoriaProducto
  unidadMedida UnidadMedida      @map("unidad_medida")
  alicuotaIva  Decimal           @map("alicuota_iva") @db.Decimal(5, 2)
  activo       Boolean           @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campanas    Campana[]
  intenciones IntencionCompra[]
  movimientosStock StockMovimiento[]

  @@map("productos")
}

enum CategoriaProducto {
  AGROQUIMICO
  FERTILIZANTE
  SEMILLA
  INOCULANTE
  NUTRICION_ANIMAL
  SANIDAD_ANIMAL
  OTRO
}

enum UnidadMedida {
  LITRO
  KILO
  UNIDAD
  TONELADA
  BOLSA
}

// ============================================================
// SEGURIDAD
// ============================================================

// Refresh tokens para renovar access tokens. Se rota en cada uso (single-use).
model RefreshToken {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tokenHash  String    @unique @map("token_hash")
  expiraAt   DateTime  @map("expira_at")
  revocadoAt DateTime? @map("revocado_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// Token de reseteo de contraseña. Mismo patrón que RefreshToken: se guarda el
// hash, nunca el token plano. Vida corta (1 hora).
model PasswordResetToken {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tokenHash String    @unique @map("token_hash")
  expiraAt  DateTime  @map("expira_at")
  usadoAt   DateTime? @map("usado_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

// ============================================================
// COMPRAS (Fase 4 — campañas y otros tipos de proceso de compra)
// ============================================================

// Una Campaña es la unidad genérica de "proceso de compra". AUT define el
// producto y el TIPO de proceso; según el tipo, algunas reglas (volumen
// mínimo, fecha de cierre, licitación) aplican o no. Sigue una máquina de
// estados estricta que depende del tipo (ver utils/transiciones-campana.js).
//
// No se crean entidades nuevas por tipo (CompraDirecta, CompraContinua):
// se generaliza con un discriminador `tipo` para reutilizar la misma cañería
// aguas abajo (intención → cotización → adjudicación → orden → entrega →
// factura) en vez de duplicarla.
model Campana {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  tipo TipoCompra @default(COLECTIVA)

  nombre      String
  descripcion String? @db.Text

  // Solo COLECTIVA/CONTINUA usan volumen mínimo; DIRECTA no.
  volumenMinimo Decimal? @map("volumen_minimo") @db.Decimal(12, 2)
  volumenMaximo Decimal? @map("volumen_maximo") @db.Decimal(12, 2)

  fechaApertura           DateTime  @map("fecha_apertura")
  // Nullable: DIRECTA se adjudica al instante y CONTINUA no cierra. Solo
  // COLECTIVA la exige (se valida en el service).
  fechaCierre             DateTime? @map("fecha_cierre")
  fechaCierreCotizaciones DateTime? @map("fecha_cierre_cotizaciones")

  // Estimación temprana de recepción que el ADMIN comunica al abrir el
  // requerimiento. Distinta de Entrega.fechaEstimada (Fase 9), que se calcula
  // recién al adjudicar según el plazoEntregaDias del proveedor ganador.
  fechaEstimadaRecepcion DateTime? @map("fecha_estimada_recepcion")

  // CONTINUA: el proceso "padre" (siempre abierto) acumula intenciones y,
  // cuando AUT decide comprar, dispara una "tanda" (Campana hija COLECTIVA o
  // DIRECTA) que sigue el flujo normal de adjudicación.
  campanaPadreId Int?      @map("campana_padre_id")
  campanaPadre   Campana?  @relation("CampanaTandas", fields: [campanaPadreId], references: [id])
  tandas         Campana[] @relation("CampanaTandas")

  // Horas antes del cierre en que se bloquea la edición de intenciones.
  horasLockoutEdicion Int @default(0) @map("horas_lockout_edicion")

  estado EstadoCampana @default(BORRADOR)

  creadaPorId       Int       @map("creada_por_id")
  creadaPor         Usuario   @relation("CampanasCreadas", fields: [creadaPorId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  canceladaAt       DateTime? @map("cancelada_at")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  intenciones  IntencionCompra[]
  cotizaciones Cotizacion[]
  adjudicacion Adjudicacion?

  @@index([estado])
  @@index([fechaCierre])
  @@map("campanas")
}

enum EstadoCampana {
  BORRADOR
  ABIERTA
  EN_LICITACION
  ADJUDICADA
  CERRADA
  CANCELADA
}

enum TipoCompra {
  COLECTIVA
  DIRECTA
  CONTINUA
}

// Intención de compra de un productor. Es el único punto de entrada del
// productor al sistema, tenga o no campaña encima (regla D.1):
// - campanaId seteado: vive dentro de una Campana ya abierta (top-down).
// - campanaId null: pedido suelto, todavía sin campaña (bottom-up, Fase 5).
// "Agrupar" (Fase 5) es asignarle campanaId a intenciones sueltas existentes,
// no crear una entidad distinta.
model IntencionCompra {
  id Int @id @default(autoincrement())

  campanaId Int?     @map("campana_id")
  campana   Campana? @relation(fields: [campanaId], references: [id])

  productorId Int       @map("productor_id")
  productor   Productor @relation(fields: [productorId], references: [id])

  // Obligatorio siempre: sin campaña es la única forma de saber qué producto
  // pidió el productor.
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  volumen       Decimal @db.Decimal(12, 2)
  observaciones String? @db.Text

  fechaDeseada              DateTime?         @map("fecha_deseada")
  modalidadEntregaPreferida ModalidadEntrega? @map("modalidad_entrega_preferida")
  // Dirección puntual cuando modalidadEntregaPreferida = ENTREGA_EN_CAMPO.
  // La FK a Deposito (para RETIRO_EN_DEPOSITO) se agrega en la migración de
  // Fase 8, cuando ese modelo exista.
  direccionEntregaCampo     String?           @map("direccion_entrega_campo") @db.Text
  formaPagoPreferida        FormaPago?        @map("forma_pago_preferida")

  estado         EstadoIntencion @default(PENDIENTE)
  motivoDescarte String?         @map("motivo_descarte") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un productor solo puede tener UNA intención por campaña. No aplica a
  // pedidos sueltos: MySQL no trata los NULL como duplicados en un índice
  // único, así que varias intenciones con campanaId = null del mismo
  // productor son válidas (PENDIENTES.md #1).
  @@unique([campanaId, productorId])
  @@index([estado])
  @@index([productoId, estado])
  @@map("intenciones_compra")
}

enum EstadoIntencion {
  PENDIENTE
  AGRUPADA
  DESCARTADA
}

enum ModalidadEntrega {
  RETIRO_EN_DEPOSITO
  ENTREGA_EN_CAMPO
}

enum FormaPago {
  TRANSFERENCIA
  ECHEQ_CORRIENTE
  ECHEQ_PLAZO
  TARJETA_AGRO
  CANJE_CEREAL
  CUENTA_CORRIENTE
  EFECTIVO
}

// ============================================================
// NOTIFICACIONES (Fase 5)
// ============================================================

// Persistencia de la campanita in-app. `tipo` queda como String (no enum)
// porque coincide 1:1 con el nombre del evento del eventBus (ver
// 04-NOTIFICACIONES.md) y ese catálogo sigue creciendo en cada fase — un
// enum obligaría a migrar el schema en cada fase solo para sumar un valor
// que ya está validado en notificaciones.listeners.js.
model Notificacion {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo           String  @db.VarChar(50)
  titulo         String
  mensaje        String  @db.Text
  enlaceRelativo String? @map("enlace_relativo")
  metadatos      Json?

  leida   Boolean   @default(false)
  leidaAt DateTime? @map("leida_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// ============================================================
// COTIZACIONES (Fase 6 — portal proveedor)
// ============================================================

// Cotización de un proveedor para una Campana en EN_LICITACION. Sobre
// cerrado (regla C.6): un proveedor nunca ve la cotización de otro, y el
// service tampoco expone las intenciones individuales al listar campañas
// cotizables, solo el volumen consolidado.
model Cotizacion {
  id Int @id @default(autoincrement())

  campanaId Int     @map("campana_id")
  campana   Campana @relation(fields: [campanaId], references: [id])

  proveedorId Int       @map("proveedor_id")
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  // Precio de contado (regla D.3): base para calcular cualquier financiación.
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 4)
  monedaPrecio   Moneda  @default(ARS) @map("moneda_precio")

  plazoEntregaDias Int @map("plazo_entrega_dias")

  // % mensual para pago financiado. Nullable: hay proveedores que solo venden de contado.
  tasaInteresMensual Decimal? @map("tasa_interes_mensual") @db.Decimal(5, 2)

  condicionesPago String   @map("condiciones_pago") @db.Text
  observaciones   String?  @db.Text
  validaHasta     DateTime @map("valida_hasta")

  // Marcada por adjudicaciones.service.js al adjudicar la campaña (Fase 7).
  // Para DIRECTA (sin portal proveedor), la fila se crea sintéticamente con
  // esGanadora=true a partir de los datos de adjudicarDirecta — así el resto
  // del flujo (Adjudicacion, ranking histórico) no necesita distinguir tipo.
  esGanadora Boolean @default(false) @map("es_ganadora")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adjudicacionGanadora Adjudicacion?

  // Un proveedor solo puede tener UNA cotización por campaña (edita, no duplica).
  @@unique([campanaId, proveedorId])
  @@map("cotizaciones")
}

enum Moneda {
  ARS
  USD
}

// ============================================================
// ADJUDICACIÓN Y ÓRDENES DE COMPRA (Fase 7)
// ============================================================

// Acto formal por el cual AUT cierra la campaña y elige al ganador.
// Una sola adjudicación por campaña (regla C.3): campanaId es único.
model Adjudicacion {
  id        Int     @id @default(autoincrement())
  campanaId Int     @unique @map("campana_id")
  campana   Campana @relation(fields: [campanaId], references: [id])

  cotizacionGanadoraId Int        @unique @map("cotizacion_ganadora_id")
  cotizacionGanadora   Cotizacion @relation(fields: [cotizacionGanadoraId], references: [id])

  // Snapshot histórico: estos valores no se recalculan, quedan fijos al momento de adjudicar.
  volumenTotalAdjudicado Decimal @map("volumen_total_adjudicado") @db.Decimal(12, 2)
  precioFinalUnitario    Decimal @map("precio_final_unitario") @db.Decimal(12, 4)

  precioMinoristaReferencia Decimal? @map("precio_minorista_referencia") @db.Decimal(12, 4)
  ahorroEstimadoTotal       Decimal? @map("ahorro_estimado_total") @db.Decimal(12, 2)
  // % de ahorro agregado (regla D.4). Null si no se cargó precioMinoristaReferencia.
  porcentajeAhorro          Decimal? @map("porcentaje_ahorro") @db.Decimal(5, 2)

  motivoEleccion String? @db.Text

  adjudicadaAt DateTime @default(now()) @map("adjudicada_at")

  ordenes OrdenCompra[]

  @@map("adjudicaciones")
}

// Compromiso firme de compra de un productor, derivado de la adjudicación.
// Una orden por cada IntencionCompra válida al momento del cierre.
model OrdenCompra {
  id             Int          @id @default(autoincrement())
  adjudicacionId Int          @map("adjudicacion_id")
  adjudicacion   Adjudicacion @relation(fields: [adjudicacionId], references: [id])
  productorId    Int          @map("productor_id")
  productor      Productor    @relation(fields: [productorId], references: [id])

  // Snapshot histórico: precio, IVA y total no se recalculan dinámicamente.
  volumenFinal   Decimal @map("volumen_final") @db.Decimal(12, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 4)
  subtotal       Decimal @db.Decimal(14, 2)
  iva            Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  // Ahorro individual de este productor (regla D.4), prorrateado desde
  // Adjudicacion.ahorroEstimadoTotal según su volumenFinal.
  ahorroEstimado   Decimal? @map("ahorro_estimado") @db.Decimal(14, 2)
  porcentajeAhorro Decimal? @map("porcentaje_ahorro") @db.Decimal(5, 2)

  estadoPago EstadoPago @default(PENDIENTE) @map("estado_pago")
  formaPago  FormaPago? @map("forma_pago")
  cuotas     Int        @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  entrega Entrega?

  @@map("ordenes_compra")
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
  VENCIDO
  CANCELADO
}

// Entrega física asociada a una orden de compra. Se crea PENDIENTE al
// adjudicar; el módulo de logística (Fase 9) maneja el resto de las
// transiciones de estado.
model Entrega {
  id            Int         @id @default(autoincrement())
  ordenCompraId Int         @unique @map("orden_compra_id")
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  productorId   Int         @map("productor_id")
  productor     Productor   @relation(fields: [productorId], references: [id])

  modalidad ModalidadEntrega
  estado    EstadoEntrega    @default(PENDIENTE)

  depositoId     Int?      @map("deposito_id")
  deposito       Deposito? @relation(fields: [depositoId], references: [id])
  direccionCampo String?   @map("direccion_campo")

  fechaEstimada DateTime? @map("fecha_estimada")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movimientosStock StockMovimiento[]

  @@index([estado])
  @@map("entregas")
}

enum EstadoEntrega {
  PENDIENTE
  EN_TRANSITO
  DISPONIBLE_PARA_RETIRO
  EN_RUTA_A_CAMPO
  ENTREGADA
  CANCELADA
}

// ============================================================
// DEPÓSITOS Y STOCK (Fase 8 — libro append-only)
// ============================================================

// Galpón físico de AUT donde llega y se almacena mercadería.
// NUNCA se borra, solo se desactiva (histórico fiscal).
model Deposito {
  id               Int      @id @default(autoincrement())
  nombre           String   @unique
  localidad        String
  direccion        String
  responsable      String?
  telefonoContacto String?  @map("telefono_contacto")
  horarioAtencion  String?  @map("horario_atencion")
  capacidadMaxima  Decimal? @map("capacidad_maxima") @db.Decimal(12, 2)
  activo           Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movimientosStock StockMovimiento[]
  entregas         Entrega[]

  @@map("depositos")
}

// Libro de movimientos de stock (append-only). El stock actual NUNCA se
// guarda como campo mutable: siempre es SUM(cantidad * signo) agrupado por
// depósito y producto (trazabilidad fiscal, sin race conditions).
model StockMovimiento {
  id Int @id @default(autoincrement())

  depositoId Int      @map("deposito_id")
  deposito   Deposito @relation(fields: [depositoId], references: [id])
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  tipo     TipoMovimientoStock
  cantidad Decimal             @db.Decimal(12, 2)
  signo    Int

  // Trazabilidad: presente cuando el movimiento se originó en una entrega (Fase 9).
  entregaId Int?     @map("entrega_id")
  entrega   Entrega? @relation(fields: [entregaId], references: [id])

  proveedorOrigen String? @map("proveedor_origen")
  observaciones   String? @db.Text

  ejecutadoPorId Int     @map("ejecutado_por_id")
  ejecutadoPor   Usuario @relation(fields: [ejecutadoPorId], references: [id])

  fecha DateTime @default(now())

  @@index([depositoId, productoId])
  @@index([fecha])
  @@map("stock_movimientos")
}

enum TipoMovimientoStock {
  INGRESO_PROVEEDOR
  EGRESO_PRODUCTOR
  AJUSTE_INVENTARIO_POSITIVO
  AJUSTE_INVENTARIO_NEGATIVO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  DEVOLUCION_PROVEEDOR
}
